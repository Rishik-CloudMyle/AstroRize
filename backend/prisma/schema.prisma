// AstroRize database schema (PostgreSQL).
// Money is stored in whole rupees (Int). Times are stored in UTC and shown in IST.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── People & sign-in ───────────────────────────

enum Role {
  CUSTOMER
  ASTROLOGER
  ADMIN
}

enum AdminRole {
  SUPER
  FINANCE
  SUPPORT
  COMPLIANCE
  MARKETING
}

model User {
  id           String     @id @default(cuid())
  campaignClaims  CampaignClaim[]
  notifications   Notification[]
  makeGoodCredits MakeGoodCredit[]
  role         Role       @default(CUSTOMER)
  adminRole    AdminRole?
  name         String
  initials     String
  /// Short name written into audit entries, e.g. "K. Prasad" (admins only).
  actorName    String?
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  /// Staff accounts can be switched off by a Super Admin; an inactive user can't sign in.
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  /// Temporary block for repeatedly sharing contact details (lib/account-blocks.ts): no messages,
  /// chats, calls, live chat/queue or gifts until then. Null = not blocked.
  blockedUntil DateTime?
  blockReason  String?
  /// When the latest block began (kept after it ends: attempts before it don't count towards a new one).
  blockedAt    DateTime?

  // Customer profile (all optional). Shown to an astrologer only when the customer
  // asks to join that astrologer's live consult queue.
  firstName  String?
  lastName   String?
  /// Woman | Man | Other | Prefer not to say
  gender     String?
  /// Calendar date of birth (no time zone).
  birthDate  DateTime? @db.Date
  /// 24-hour "HH:MM", or null when the customer doesn't know it.
  birthTime  String?
  birthPlace String?
  city       String?
  state      String?
  /// Public URL of the profile photo, e.g. /api/media/<file>.
  photoUrl   String?

  astrologer     Astrologer?
  wallet         Wallet?
  sessions       Session[]
  transactions   Transaction[]
  payments       Payment[]
  consultations  Consultation[]
  dataRequests   DataRequest[]
  queueEntries   LiveQueueEntry[]
  messageThreads MessageThread[]
  bookedSlots    AvailabilitySlot[]

  /// Customer paused their own account ("Deactivate"): signed out everywhere; signing in again
  /// clears it. Different from `active`, which only staff can change.
  pausedAt       DateTime?
  /// Customer deleted their account: personal details are erased; financial records stay
  /// (anonymised) for the accounting and tax retention the law requires.
  deletedAt      DateTime?
  walletRefunds  WalletRefund[]
  directMembers  DirectMember[]
  directMessages DirectMessage[]
  welcomeBenefit WelcomeBenefit?
  giftsSent      GiftSend[]
  supportTickets SupportTicket[]
}

/// The one-time welcome benefit (spec AR-WEL): one complimentary consultation per person,
/// granted on first sign-up with a verified mobile number. It never expires; it is used up only
/// when a complimentary consultation CONNECTS (a request that is declined, missed or cancelled
/// leaves it GRANTED). Keyed by a hash of the verified number, so deleting the account and signing
/// up again with the same number never grants a second one.
model WelcomeBenefit {
  id             String    @id @default(cuid())
  /// sha256 of the verified mobile number (stays after account deletion; no personal data).
  identityKey    String    @unique
  /// The customer holding it (null once that account is deleted).
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id])
  /// GRANTED | RESERVED | CONSUMED | REVOKED
  status         String    @default("GRANTED")
  grantedAt      DateTime  @default(now())
  /// The consultation it is reserved for or was used on.
  consultationId String?
  reservedAt     DateTime?
  consumedAt     DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  /// Times it came back after a call dropped early through no fault of the customer (bounded).
  faultRestores  Int       @default(0)
  /// One-time joining bonus (free minutes) given when this mobile number first joined: Config
  /// welcome.joining_bonus_minutes at that moment. Used after the week's free minutes; never resets.
  bonusMinutes   Int       @default(0)
  updatedAt      DateTime  @updatedAt
  uses           FreeCallUse[]

  @@index([status])
}

/// An astrologer's change to their own per-minute price. Decreases apply at once (status APPLIED);
/// increases wait as PENDING until staff with the Astrologer lifecycle page approve (APPROVED, and the
/// price changes then) or reject them. Finance sees the whole list read-only.
model PriceChange {
  id             String     @id @default(cuid())
  astrologerId   String
  astrologer     Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  fromPrice      Int
  toPrice        Int
  /// Which price: "CHAT" (the separate chat price, client Nov 2026) or null = calls (voice; video and
  /// Instant Call follow it). Nullable so rows from before chat had its own price need no change.
  channel        String?
  /// PENDING | APPROVED | REJECTED | APPLIED (a decrease, live at once) | WITHDRAWN (by the astrologer)
  status         String     @default("PENDING")
  requestedAt    DateTime   @default(now())
  decidedAt      DateTime?
  decidedById    String?
  decidedByName  String?
  /// Why it was rejected (shown to the astrologer).
  reason         String?

  @@index([status, requestedAt])
  @@index([astrologerId, requestedAt])
}

/// One free call that connected, counted against the person's allowance (Config: how many free
/// calls per customer, per period — once ever, a week or a month). Keyed by the same mobile-number
/// identity as WelcomeBenefit, so a new account on the same number shares the count.
model FreeCallUse {
  id             String         @id @default(cuid())
  identityKey    String
  benefit        WelcomeBenefit @relation(fields: [identityKey], references: [identityKey])
  consultationId String         @unique
  astrologerId   String
  usedAt         DateTime       @default(now())
  /// Set when the call dropped early through no fault of the customer and the use was given back.
  restoredAt     DateTime?
  /// Free minutes this call took (the length they chose), from the week's minutes and then the joining bonus.
  minutes        Int            @default(0)
  /// The part of `minutes` taken from the one-time joining bonus (the rest is from the week's minutes).
  bonusMinutes   Int            @default(0)

  @@index([identityKey, usedAt])
}

/// Money owed back to a customer from their wallet (e.g. on account deletion). Paid to the
/// original payment method: automatic once the payment gateway is connected; until then Finance
/// processes it in the admin console and marks it paid.
model WalletRefund {
  id            String    @id @default(cuid())
  /// e.g. "WRF-48213"
  ref           String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  /// Service balance only, in rupees (promotional credit is not refundable).
  amount        Int
  /// ACCOUNT_DELETION
  reason        String
  /// PENDING | PAID | FAILED
  status        String    @default("PENDING")
  /// Original payment method (provider + last payment reference, when known).
  method        String
  providerRef   String?
  processedById String?
  processedBy   String?
  processedAt   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

/// A conversation started by an admin with anyone: other staff, an astrologer or a customer.
model DirectThread {
  id          String          @id @default(cuid())
  /// Optional topic, e.g. "Payout batch PB-2026-09-B".
  subject     String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())
  members     DirectMember[]
  messages    DirectMessage[]
}

model DirectMember {
  threadId   String
  thread     DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// For unread counts.
  lastReadAt DateTime?

  @@id([threadId, userId])
  @@index([userId])
}

model DirectMessage {
  id        String       @id @default(cuid())
  threadId  String
  thread    DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime     @default(now())

  @@index([threadId, createdAt])
}

/// One signed-in browser. The session cookie carries this id; logging out revokes it.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

/// Six-digit sign-in codes sent by SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ─────────────────────────── Astrologers ───────────────────────────

enum Recognition {
  PREMIUM
  TRUSTED
  PROVEN
  RISING
  FRESH
}

enum Presence {
  ON
  BUSY
  LIVE
  OFF
}

model Astrologer {
  /// Short stable id, e.g. "raghav".
  id                  String      @id
  slug                String      @unique
  userId              String?     @unique
  user                User?       @relation(fields: [userId], references: [id])
  name                String
  /// Male | Female (directory filter)
  gender              String?
  /// Last time the astrologer's portal was open (heartbeat). Online astrologers who go quiet
  /// are switched offline automatically, so customers never see a stale "online".
  lastSeenAt          DateTime?
  initials            String
  greeting            String
  recognition         Recognition
  presence            Presence    @default(OFF)
  skills              String[]
  languages           String[]
  years               Int
  rating              Float?
  consults            Int         @default(0)
  /// Standard per-minute rate for calls (voice) (₹), and for chat unless chatPrice is set. Video adds the video premium.
  price               Int
  /// Per-minute chat rate (₹) when the astrologer set chat apart from calls (client, Nov 2026); null = same as price.
  chatPrice           Int?
  /// Last time the chat price actually changed (its own once-every-N-days cooldown), or null.
  chatPriceChangedAt  DateTime?
  /// Original rate shown struck through when discounted (₹), or null.
  was                 Int?
  /// Instant Call rate = price × this multiplier.
  instantMultiplier   Float       @default(3)
  eta                 String?
  /// Published "about" text on the public profile.
  about               String
  photo               String
  /// Count of 5★, 4★, 3★, 2★, 1★ ratings.
  ratingDistribution  Int[]
  /// draft | review | interview | docs | negotiation | pricing | training | active | rejected
  lifecycle           String      @default("active")
  /// none | partial | full
  suspension          String      @default("none")
  /// Why staff suspended the account (shown to the astrologer), and when.
  suspensionReason    String?
  suspendedAt         DateTime?
  /// End of a temporary suspension placed by a contact-sharing block (lifted by itself then); null = until staff lift it.
  suspendedUntil      DateTime?
  /// Popularity ranking used for the default directory order.
  rank                Int         @default(0)
  createdAt           DateTime    @default(now())
  /// Public URL of the intro video shown on the profile (e.g. /api/media/<file>), if any.
  introVideoUrl       String?
  /// Photos on the public profile's gallery (public URLs, in display order), set from the portal.
  gallery             String[]    @default([])
  /// Takes part in the welcome campaign: customers can use their one free call with them.
  /// Set by staff (Astrologer lifecycle); astrologers can't switch it on themselves by default.
  freeCallsEnabled    Boolean     @default(false)
  /// Most complimentary calls this astrologer takes per `freeCallsLimitPeriod` (IST); null = the
  /// platform default. Set by the astrologer in the portal, within the admin maximum.
  freeCallsDailyLimit Int?
  /// DAY | WEEK — the period `freeCallsDailyLimit` counts over.
  freeCallsLimitPeriod String   @default("DAY")
  /// When the astrologer went live (lifecycle → active): starts the "new astrologer" share period.
  activatedAt         DateTime?
  /// Last time the astrologer changed their own price (for the change cooldown).
  priceChangedAt      DateTime?
  giftsReceived       GiftSend[]

  reviews            Review[]
  liveRoom           LiveRoom?
  consultations      Consultation[]
  slots              AvailabilitySlot[]
  threads            MessageThread[]
  profileSubmissions ProfileSubmission[]
  complianceNotices  ComplianceNotice[]
  earnings           EarningsLine[]
  priceChanges       PriceChange[]
  training           TrainingModule[]
  application        ApplicationDraft?
}

/// Customer reviews. VISIBLE ones show on the public profile; FLAGGED/SOFT_HIDDEN ones wait in the admin moderation queue.
model Review {
  /// e.g. "REV-99131"
  id             String      @id
  astrologerId   String?
  astrologer     Astrologer? @relation(fields: [astrologerId], references: [id])
  /// Shown in the moderation queue even when the astrologer is not on the platform yet.
  astrologerName String
  customerName   String
  stars          Int
  text           String
  /// VISIBLE | FLAGGED | SOFT_HIDDEN | REMOVED
  status         String      @default("VISIBLE")
  /// Moderation rule that flagged it, e.g. "R-04 POLICY".
  flag           String?
  hiddenAt       DateTime?
  removedReason  String?
  moderatedBy    String?
  consultationId String?     @unique
  createdAt      DateTime    @default(now())

  @@index([astrologerId, status])
}

// ─────────────────────────── Live rooms ───────────────────────────

model LiveRoom {
  id            String             @id
  astrologerId  String             @unique
  astrologer    Astrologer         @relation(fields: [astrologerId], references: [id])
  topic         String
  /// Session details set when going live and editable while live (spec AR-LIVE §4).
  title         String             @default("")
  /// e.g. Marriage, Career (from the live categories setting).
  category      String?
  language      String?
  /// What the astrologer expects, in minutes (5–480).
  durationMins  Int?
  gifts         GiftSend[]
  viewers       Int                @default(0)
  thumb         String
  /// normal | private | monitor | degrade
  state         String             @default("normal")
  isLive        Boolean            @default(true)
  queueCapacity Int                @default(20)
  eta           String
  rank          Int                @default(0)
  startedAt     DateTime           @default(now())
  pollQuestion  String
  pollOptions   String[]
  /// Votes per option (seeded with the prototype's split, then real votes add to it).
  pollCounts    Int[]
  chat          ChatMessage[]
  votes         PollVote[]
  queue         LiveQueueEntry[]
  announcements LiveAnnouncement[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    String
  text      String
  userId    String?
  /// message | join | gift (join and gift lines are written by the server)
  kind      String   @default("message")
  /// Viewer's photo at the time (null = initials).
  photo     String?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// One vote per viewer per poll. Viewers are identified by user id, or an anonymous browser id.
model PollVote {
  id          String   @id @default(cuid())
  roomId      String
  room        LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voterKey    String
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([roomId, voterKey])
}

/// Announcements an astrologer posts to their live room; shown above the room chat.
model LiveAnnouncement {
  id        String   @id @default(cuid())
  roomId    String
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model LiveQueueEntry {
  id             String   @id @default(cuid())
  roomId         String
  room           LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  alias          String
  /// PRIVATE | PUBLIC
  mode           String
  consent        Boolean  @default(false)
  /// WAITING | ACCEPTED | DECLINED | LEFT
  status         String   @default("WAITING")
  /// The private consultation this request became once the astrologer accepted it.
  consultationId String?
  createdAt      DateTime @default(now())

  @@index([roomId, status])
}

// ─────────────────────────── Wallet & payments ───────────────────────────

model Wallet {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Talk-time paid for by the customer (₹).
  service        Int       @default(0)
  /// Promotional credit (₹). Used before service balance.
  promo          Int       @default(0)
  promoExpiresAt DateTime?
  /// Amount currently held for an ongoing consultation (₹).
  held           Int       @default(0)
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Recharge | Cashback | Consultation | Refund | Gift sent
  type      String
  ref       String   @unique
  bucket    String
  /// Positive = credit, negative = debit (₹).
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  gst             Int
  bonus           Int
  /// Campaign cashback added on top of `bonus` (promotional credit), and the claim it came from.
  cashback        Int       @default(0)
  campaignClaimId String?
  total           Int
  /// CREATED | PAID | FAILED
  status          String    @default("CREATED")
  /// "razorpay" (or "mock" for old dev-only recharges made before Razorpay was connected).
  provider        String
  providerOrderId String    @unique
  /// Razorpay's payment id (pay_…) once the customer has paid; unique so one payment credits once.
  providerPaymentId String? @unique
  /// How they paid (upi, card, netbanking, wallet…), from Razorpay.
  method          String?
  /// Why a payment failed (Razorpay's error description), shown to the customer and Finance.
  failureReason   String?
  /// ₹ of this payment's amount already refunded through Razorpay (bank refunds of service balance).
  refundedAmount  Int       @default(0)
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}

/// Recharge amounts offered on the wallet page, with the promotional bonus each adds.
model Denomination {
  amount  Int     @id
  bonus   Int     @default(0)
  enabled Boolean @default(true)
}

// ─────────────────────────── Consultations ───────────────────────────

model Consultation {
  id                   String           @id @default(cuid())
  /// e.g. "SES-88214"
  ref                  String           @unique
  /// PAID | COMPLIMENTARY_THEN_PAID (the welcome call: free for complimentarySeconds, then the
  /// same session continues at `rate` if the wallet allows, else it ends).
  billingMode          String           @default("PAID")
  /// Free seconds snapshotted when the session was requested (welcome calls only).
  complimentarySeconds Int              @default(0)
  /// DIRECT (from a profile/directory) | LIVE (a private consultation taken from a live room)
  origin               String           @default("DIRECT")
  /// The live room a LIVE consultation came from.
  liveRoomId           String?
  messages             ConsultMessage[]
  customerId           String?
  customer             User?            @relation(fields: [customerId], references: [id])
  /// What the astrologer sees instead of the customer's name, e.g. "A-8821".
  customerAlias        String
  astrologerId         String
  astrologer           Astrologer       @relation(fields: [astrologerId], references: [id])
  /// CHAT | VOICE | VIDEO
  mode                 String
  /// STANDARD | INSTANT | FIXED | WELCOME
  kind                 String           @default("STANDARD")
  /// WEB | LIVE | APP
  source               String           @default("WEB")
  /// Per-minute rate snapshotted when the consultation was requested (₹).
  rate                 Int
  /// The astrologer's price before a campaign discount (null = no discount); `rate` is what the customer pays.
  listRate             Int?
  /// The claimed campaign whose discount applies, and its percent.
  campaignClaimId      String?
  discountPct          Int              @default(0)
  /// A free replacement call (make-good) this consultation uses.
  makeGoodCreditId     String?
  /// REQUESTED | CONNECTING | ACTIVE | ENDED | REJECTED | TIMED_OUT | CANCELLED
  status               String           @default("REQUESTED")
  heldAmount           Int              @default(0)
  requestedAt          DateTime         @default(now())
  /// When the request reached the front of the queue; the astrologer has 3 minutes from then to accept.
  offeredAt            DateTime?
  connectedAt          DateTime?
  /// When each side was really in the conversation (chat window open / voice-video media flowing).
  customerJoinedAt     DateTime?
  astrologerJoinedAt   DateTime?
  /// When both were in: the free time and the paid clock count only from here (null = not started, ₹0).
  billingStartedAt     DateTime?
  endedAt              DateTime?
  /// user | cap | exhausted | astrologer
  endReason            String?
  billedSeconds        Int              @default(0)
  billedMinutes        Int              @default(0)
  total                Int              @default(0)
  promoUsed            Int              @default(0)
  serviceUsed          Int              @default(0)
  stars                Int?
  reviewText           String?
  /// When each side accepted the recording notice (voice/video: audio only, client Nov 2026).
  /// A call is recorded only when both are set; null = not asked (chat, or requested before recording began).
  customerRecordingConsentAt   DateTime?
  astrologerRecordingConsentAt DateTime?
  recordings           CallRecording[]

  @@index([astrologerId, status])
  @@index([customerId, requestedAt])
}

model DataRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// download | correct | consent | nominee | delete
  kind      String
  /// RECEIVED | IN_PROGRESS | DONE
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now())
}

// ─────────────────────────── Astrologer portal ───────────────────────────

model AvailabilitySlot {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  /// Calendar day in IST (stored at 00:00 UTC of that date).
  date         DateTime   @db.Date
  /// "HH:MM" in IST.
  start        String
  end          String
  /// OPEN | BOOKED | CANCELLED
  state        String     @default("OPEN")
  detail       String?
  /// Who booked this slot (BOOKED only). The astrologer sees their real name and profile.
  customerId   String?
  customer     User?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([astrologerId, date])
}

model MessageThread {
  id               String     @id @default(cuid())
  astrologerId     String
  astrologer       Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  customerAlias    String
  /// The customer account this conversation is with. The astrologer sees their real name and,
  /// on request, their profile (like the live and consultation queues).
  customerId       String?
  customer         User?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  updatedAt        DateTime   @default(now())
  /// When each side last opened the conversation: their unread badge counts only the other
  /// side's messages after this (null = never opened).
  astrologerReadAt DateTime?
  customerReadAt   DateTime?
  messages         Message[]

  @@unique([astrologerId, customerId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// CUSTOMER | ASTROLOGER | SYSTEM
  sender    String
  /// May be empty when the message is only a photo or video.
  text      String
  /// A photo or video sent with the message: the stored file name (served only to the
  /// thread's customer and astrologer, and staff), or null.
  attachment     String?
  /// IMAGE | VIDEO (set with `attachment`).
  attachmentKind String?
  /// A video being compressed (lib/media-jobs.ts): PROCESSING until the media worker is done,
  /// FAILED when it couldn't be (the file is gone or unusable). Null = ready (photos, older videos).
  attachmentState  String?
  /// The poster frame of a compressed video: a stored private file name, or null.
  attachmentPoster String?
  /// True when the message was stopped because it contained contact details.
  blocked   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

/// Background media work (compressing message videos), done by the media worker (src/worker.ts),
/// or inside the API when MEDIA_WORKER=inline. Workers claim a QUEUED job with one atomic UPDATE,
/// so several can run side by side.
model MediaJob {
  id          String    @id @default(cuid())
  /// VIDEO_TRANSCODE
  kind        String
  /// QUEUED | RUNNING | DONE | FAILED
  status      String    @default("QUEUED")
  /// The message the file belongs to (no relation: the job outlives a deleted message and then
  /// just cleans up after itself).
  messageId   String?
  /// Storage key of the uploaded original, and its size in bytes.
  input       String
  inputBytes  Int
  /// Storage keys of the results (set when DONE), and the compressed size.
  output      String?
  poster      String?
  outputBytes Int?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  /// Not claimed before this time (retry back-off).
  runAfter    DateTime  @default(now())
  /// When a worker claimed it, and which one ("<host>:<pid>"). A RUNNING job locked too long ago
  /// is handed out again (its worker died).
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAfter])
  @@index([messageId])
}

/// Bio / skills changes waiting for moderation. The public profile only changes once approved.
model ProfileSubmission {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  bio          String
  skills       String[]
  /// PENDING | APPROVED | REJECTED
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
}

model ComplianceNotice {
  /// e.g. "CMP-2214"
  id           String     @id
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  category     String
  summary      String
  issuedAt     DateTime
  respondBy    DateTime
  /// OPEN | RESPONDED | DECIDED
  status       String     @default("OPEN")
  response     String?
  respondedAt  DateTime?
}

/// One line of an astrologer's earnings statement.
model EarningsLine {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  date         DateTime
  /// Session or adjustment reference, e.g. "SES-88214", "ADJ-00412".
  sessionRef   String
  /// voice | chat | video | emergency | welcome | adjustment
  kind         String
  mode         String
  minutes      Int
  gifts        Int        @default(0)
  /// What the line is worth before the split, ₹ (customer charge, gift price, or free minutes
  /// valued at the astrologer's rate). Null on lines written before shares existed (valued on read).
  gross        Int?
  /// The astrologer's share of `gross`, percent, fixed when the line was written.
  sharePct     Int?
  /// The astrologer's earnings from this line, ₹ (gross × sharePct / 100, rounded down).
  amount       Int?
  /// CUSTOMER (paid from a customer's wallet) | PLATFORM (AstroRize pays: free-call compensation).
  fundedBy     String     @default("CUSTOMER")
  /// Complimentary seconds this line compensates (free-call compensation lines).
  freeSeconds  Int        @default(0)
  /// ₹ of `gross` that AstroRize paid because of a campaign discount (the customer paid gross − discount).
  discount     Int        @default(0)
  /// The payout batch that pays this line, once batched.
  payoutBatchId String?
  payoutBatch  PayoutBatch? @relation(fields: [payoutBatchId], references: [id])

  @@index([astrologerId, date])
  @@index([payoutBatchId])
}

model TrainingModule {
  id           String     @id @default(cuid())
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  label        String
  done         Boolean    @default(false)
  dueAt        DateTime?
  rank         Int        @default(0)
}

/// The application wizard, auto-saved as the astrologer types.
model ApplicationDraft {
  astrologerId String     @id
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  currentStep  Int        @default(0)
  /// Field edits keyed "step-field", e.g. { "1-0": "Raghav Joshi" }.
  values       Json       @default("{}")
  savedAt      DateTime   @default(now())
}

// ─────────────────────────── Admin console ───────────────────────────

model ConfigKey {
  key         String   @id
  /// Flagged keys need a second approver.
  flagged     Boolean  @default(false)
  description String
  value       String
  /// global | country | segment
  scope       String
  /// e.g. "0–100"
  bounds      String
  /// Impact estimate shown before changing the value.
  dryRun      String
  domain      String
  version     Int      @default(1)
  rank        Int      @default(0)
  updatedAt   DateTime @default(now())
}

/// Every proposed config change, approved or not. Approved ones form the version history.
model ConfigChange {
  id             String    @id @default(cuid())
  key            String
  fromValue      String
  toValue        String
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | ROLLED_BACK
  status         String
  version        Int?
  draftedById    String?
  draftedByName  String
  approvedById   String?
  approvedByName String?
  effectiveAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([key, createdAt])
}

model PayoutBatch {
  /// e.g. "PB-2026-09-B"
  id             String     @id
  /// EARNINGS (customer-paid shares, half-monthly) | FREE_CALLS (free-call compensation, monthly or weekly)
  kind           String     @default("EARNINGS")
  cycle          String
  periodStart    DateTime?
  periodEnd      DateTime?
  lines          EarningsLine[]
  astrologers    Int
  gross          Int
  tds            Int
  /// DRAFT | APPROVED | RELEASED
  state          String
  approvedById   String?
  approvedByName String?
  approvedRole   AdminRole?
  approvedAt     DateTime?
  releasedById   String?
  releasedByName String?
  releasedAt     DateTime?
  createdAt      DateTime   @default(now())
}

model SupportTicket {
  /// e.g. "TKT-3391"
  id            String   @id
  subject       String
  /// EVIDENCE_REQUESTED | INVESTIGATING | REFUND_PROPOSED | REFUND_INITIATED | ESCALATED | RESOLVED
  state         String
  slaDueAt      DateTime
  customerAlias String
  sessionRef    String
  /// NONE | PROPOSED | INITIATED
  refundState   String   @default("NONE")
  refundAmount  Int      @default(0)
  proposedBy    String?
  approvedBy    String?
  /// REFUND (customer refunded; astrologer's share reversed) | MAKE_GOOD (free replacement call) | null
  resolution    String?
  createdAt     DateTime @default(now())
  /// The customer who raised it from their account (Help & support, or a wallet billing issue).
  /// Null for reports raised by astrologers or staff, and for issues raised before Nov 2026 (those
  /// are found through their "support.ticket.raise" audit entry).
  customerId       String?
  customer         User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// What the customer said it is about: PAYMENT_REFUND | WALLET | CONSULTATION | ASTROLOGER |
  /// ACCOUNT | TECHNICAL | OTHER (null for older tickets and reports).
  category         String?
  /// The customer's own words (subject stays the one-line summary).
  description      String?
  /// The recharge (Payment.id) the issue is about, when the customer picked one.
  paymentId        String?
  /// The team working it now: support | finance | compliance | marketing | super. Every new
  /// issue starts with Support, who may forward it.
  assignedTeam     String   @default("support")
  /// Staff asked the customer something and are waiting for their answer ("Waiting for you").
  awaitingCustomer Boolean  @default(false)
  /// How a ticket closed without a refund or free call: RESOLVED (sorted out) | CLOSED (no action).
  closedAs         String?
  /// Last reply, forward or status change (for sorting and "new reply" marks).
  lastActivityAt   DateTime @default(now())
  /// When the customer last opened the issue (staff replies after it count as unread).
  customerReadAt   DateTime?
  messages         SupportTicketMessage[]

  @@index([customerId])
  @@index([assignedTeam])
}

/// The conversation on a support ticket: customer messages, staff replies (the customer sees them)
/// and internal notes (staff only — never sent to the customer's API).
model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// CUSTOMER | STAFF
  author     String
  /// The user who wrote it (no relation: the record outlives staff accounts).
  authorId   String?
  /// Staff short name (internal; customers see the team, never the person).
  authorName String
  /// The staff member's team when they wrote it: support | finance | compliance | marketing | super.
  team       String?
  /// Staff-only note.
  internal   Boolean       @default(false)
  text       String
  /// A screenshot the customer attached: the stored private file name, or null.
  attachment String?
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Astrologer applications being worked by HR.
model Applicant {
  /// e.g. "APP-2214"
  id           String   @id
  /// The astrologer account that submitted this application from the portal (null for older
  /// applications entered by HR). Stage changes are mirrored onto Astrologer.lifecycle.
  astrologerId String?  @unique
  name         String
  skill        String
  /// Under review | Interview | Docs pending | Negotiation | Pricing | Training
  state        String
  submittedAt  DateTime
  breach       Boolean  @default(false)
  /// Optimistic-locking version: an action must quote the version it saw.
  version      Int      @default(1)
  /// Rate negotiation rows, round counters, etc.
  negotiation  Json?
}

model MonitorTarget {
  id         String   @id
  astroLabel String
  /// CRITICAL | HIGH | PROMOTED | PRIVATE | SAMPLING
  band       String
  reason     String
  startedAt  DateTime
  /// Private consultations cannot be observed.
  denied     Boolean  @default(false)
}

model ObserverLease {
  id         String    @id @default(cuid())
  adminId    String
  adminName  String
  targetId   String
  breakGlass Boolean   @default(false)
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  releasedAt DateTime?
}

model Campaign {
  id       String @id
  name     String
  /// Legacy display fields from the first campaigns (recharge amounts, "5–14%").
  denoms   String @default("")
  cashback String @default("")
  /// DRAFT | SUBMITTED | UNDER_REVIEW | ACTIVE | EXPIRED
  state    String
  rank     Int    @default(0)
  /// RECHARGE_CASHBACK (percent back as promotional credit on a recharge) | CONSULT_DISCOUNT
  /// (percent off the per-minute price, paid by AstroRize) | BONUS_CREDIT (flat promotional credit on claim).
  kind        String    @default("RECHARGE_CASHBACK")
  /// What customers read on the offer.
  description String    @default("")
  /// Cashback or discount percent (RECHARGE_CASHBACK, CONSULT_DISCOUNT).
  percent     Int?
  /// Flat credit, ₹ (BONUS_CREDIT).
  flatAmount  Int?
  /// Smallest recharge the cashback applies to, ₹.
  minRecharge Int?
  /// Most one use can be worth, ₹ (cashback or discount cap).
  maxBenefit  Int?
  /// When customers can claim it (null start = when approved; null end = until expired by staff).
  startsAt    DateTime?
  endsAt      DateTime?
  /// Days a claimed offer stays usable.
  claimValidDays Int     @default(7)
  /// Times one customer can use it once claimed.
  usesPerCustomer Int    @default(1)
  /// ALL | NEW (customers with no paid consultation yet)
  audience    String    @default("ALL")
  createdAt   DateTime  @default(now())
  claims      CampaignClaim[]
}

/// A customer's claimed campaign offer. Only claimed offers apply (client decision).
model CampaignClaim {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt   DateTime  @default(now())
  expiresAt   DateTime
  usesLeft    Int
  /// ACTIVE | USED | EXPIRED
  status      String    @default("ACTIVE")
  lastUsedAt  DateTime?

  @@unique([campaignId, userId])
  @@index([userId, status])
}

/// In-app notifications (the bell) for customers and astrologers: new offers, daily offer
/// summaries, price decisions, suspensions, make-good calls.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. campaign.new | campaign.daily | campaign.expiring | makegood.offered | account.suspended
  kind      String
  title     String
  body      String
  /// Where tapping it goes, e.g. /offers
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

/// A free replacement call offered on a complaint instead of a refund: the customer gets `minutes`
/// with the same astrologer, free; the astrologer keeps the original earnings and isn't paid again.
model MakeGoodCredit {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerId   String
  ticketId       String
  /// The session the complaint was about.
  sessionRef     String
  minutes        Int
  /// AVAILABLE | USED | EXPIRED | CANCELLED
  status         String    @default("AVAILABLE")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  /// The replacement consultation, once used.
  consultationId String?   @unique

  @@index([userId, status])
}

model Gift {
  id    String @id @default(cuid())
  icon  String
  name  String
  price Int
  /// ACTIVE | PENDING ADMIN | AT CAP | DRAFT
  state String
  rank  Int    @default(0)
}

model RecordingModality {
  mode      String @id
  note      String
  retention String
  /// enabled | blocked | disabled
  status    String
  rank      Int    @default(0)
}

/// Append-only record of every privileged action.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorId     String?
  actorName   String
  action      String
  object      String
  diff        String
  correlation String
  breakGlass  Boolean  @default(false)

  @@index([at])
}

/// Small named settings and analytics snapshots (e.g. cashback floor mode, DAU series).
model Setting {
  key   String @id
  value Json
}

/// A gift a viewer sent during a live session (paid from their wallet's service balance;
/// the astrologer's share shows in their earnings).
model GiftSend {
  id           String     @id @default(cuid())
  roomId       String
  room         LiveRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  astrologerId String
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  giftId       String
  name         String
  icon         String
  /// Price paid, in rupees.
  price        Int
  /// The wallet transaction reference.
  ref          String     @unique
  createdAt    DateTime   @default(now())

  @@index([roomId, createdAt])
  @@index([astrologerId, createdAt])
}

/// Messages inside a consultation (Chat consultations, and the text box of voice/video calls).
/// Contact details are blocked like everywhere else; kept for the chat retention period.
model ConsultMessage {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  /// CUSTOMER | ASTROLOGER | SYSTEM
  sender         String
  text           String
  /// The message contained contact details and was not delivered.
  blocked        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([consultationId, createdAt])
}

/// A birthplace looked up once (OpenStreetMap) and remembered, so the same search never asks again.
model Place {
  id        String   @id @default(cuid())
  /// Normalised search text, e.g. "kothrud, pune".
  query     String   @unique
  /// Display name, e.g. "Kothrud, Pune, Maharashtra, India".
  name      String
  latitude  Float
  longitude Float
  /// IANA time zone, e.g. "Asia/Kolkata".
  timezone  String
  createdAt DateTime @default(now())
}

/// A chart the astrology engine generated (Kundli), kept so it can be shown again without
/// recalculating. Belongs to the customer who made it.
model Chart {
  id        String   @id @default(cuid())
  userId    String?
  /// kundli | matchmaking
  kind      String
  /// Name(s) the chart was made for.
  label     String
  /// The birth details given (date, time, place, coordinates, time zone).
  input     Json
  /// The calculated chart (positions, houses, dasha…), engine version included.
  result    Json
  engine    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// The audio recording of a voice or video consultation (audio only, client Nov 2026). Recorded in
/// the browsers of the call (both sides, each a "take"; a page reload mid-call starts a new take),
/// uploaded in numbered chunks, assembled into one file when the take ends. Only a Super Admin can
/// listen (capability recording.listen). Later a provider-side recorder (ZEGO Cloud Recording to S3)
/// can write rows here too, with side "SERVER".
model CallRecording {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  /// ASTROLOGER | CUSTOMER (whose browser recorded it) | SERVER (a provider recording, later)
  side           String
  /// 1, 2, … per side.
  take           Int
  /// RECORDING | READY | PARTIAL (ended without a clean finish) | FAILED (nothing usable) |
  /// DISCARDED (a duplicate take the kept take fully covers; its file is deleted) | DELETED (retention)
  status         String       @default("RECORDING")
  /// e.g. "audio/webm;codecs=opus" or "audio/mp4"
  mimeType       String
  /// Where the assembled file is (a private storage key, never a public URL); null until assembled.
  storageKey     String?
  /// Chunks received in order (sequence numbers 0 … chunks-1) and their total size in bytes.
  chunks         Int          @default(0)
  bytes          Int          @default(0)
  /// Length as reported by the recording browser.
  durationMs     Int          @default(0)
  startedAt      DateTime     @default(now())
  lastChunkAt    DateTime?
  endedAt        DateTime?
  /// Why it is PARTIAL / FAILED / DISCARDED.
  note           String?
  /// Set when a media worker has post-processed (e.g. remuxed) the file. Hook; unused for now.
  processedAt    DateTime?

  @@unique([consultationId, side, take])
  @@index([status, startedAt])
}
