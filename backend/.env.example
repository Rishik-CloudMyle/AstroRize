# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL. Locally: run `npx prisma dev --name astrorize --detach` and use the URLs it prints.
# In production: the connection string of your managed PostgreSQL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Only needed for `prisma migrate dev` (a scratch database Prisma uses to check migrations).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Max open connections. Keep 1 for the local `prisma dev` database; raise it (e.g. 10) in production.
DATABASE_POOL_MAX=1

# Port the API listens on.
PORT=4000

# Secret used to sign session cookies. Use a long random string (at least 32 characters).
# The frontend needs the SAME value so it can check sessions before loading /portal and /admin.
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# "development" shows OTP codes in the API response and logs (no SMS provider is connected yet).
# Use "production" when deployed: mobile sign-in is then refused until an SMS provider is added.
# Sign-in codes are signed with SESSION_SECRET: changing it makes codes already sent stop working.
NODE_ENV=development

# Where the website runs (used for CORS when the frontend calls the API directly).
FRONTEND_ORIGIN="http://localhost:3000"

# Production first deploy only: `npm run db:bootstrap` creates the first Super Admin from these
# while no Super Admin exists (later runs ignore them). Password: 10+ characters, a letter and a
# number. Remove them once you have signed in and changed the password.
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-123"
# BOOTSTRAP_ADMIN_NAME="Full Name"

# ZEGO real-time voice/video/live (ZEGO console → your project). Leave empty until the client's
# ZEGO account exists: calls and lives then work without audio/video and the site says so.
# ZEGO_APP_ID=123456789
# ZEGO_SERVER_SECRET=32-character-server-secret-here
# The project's web Server URL from the ZEGO console (domains differ per project; empty = standard zegocloud address).
# ZEGO_SERVER_URL=wss://webliveroomXXXXXXXXXX-api.zegocloud.com/ws

# Birthplace search (OpenStreetMap Nominatim). Their usage policy requires identifying the app:
# put a real contact email here (sent in the User-Agent). Every result is cached in the Place
# table, so each place is asked for only once. NOMINATIM_URL can point to a self-hosted server.
# GEOCODER_CONTACT="support@your-domain.example"
# NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Razorpay (wallet recharges and refunds). Dashboard → Account & Settings → API keys.
# Test mode keys start with rzp_test_, live keys with rzp_live_. Until both are set, recharges are
# off and the website says payments aren't connected. Never share the secret; only the key id is
# sent to browsers. (RAZORPAY_ID / RAZORPAY_SECRET_KEY are accepted as the same two values.)
# RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=your-key-secret
# The secret you type when adding the webhook in the dashboard (Webhooks → Add new webhook), for
# https://<your API or website domain>/api/payments/razorpay/webhook with the events
# payment.captured, payment.failed, refund.processed and refund.failed.
# RAZORPAY_WEBHOOK_SECRET=a-long-random-string
